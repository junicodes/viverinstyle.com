# Supabase Configuration
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Payment Gateway (optional - set in Supabase Edge Function secrets)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Server-side secrets (set in Supabase Dashboard > Edge Functions > Secrets):
# STRIPE_SECRET_KEY=sk_test_...
# RESEND_API_KEY=re_...
# OPENAI_API_KEY=sk-...
# AUSPOST_API_KEY=your_australia_post_api_key
# AUSPOST_FROM_POSTCODE=5160
# When a parcel exceeds Aus Post standard limits (e.g. 105 cm), Edge Function uses an estimate (tune in Supabase secrets):
# OVERSIZE_FREIGHT_BASE_AUD=89
# OVERSIZE_FREIGHT_PER_KG_AUD=3.2
# OVERSIZE_FREIGHT_PER_CM_OVER_105_AUD=1.5
